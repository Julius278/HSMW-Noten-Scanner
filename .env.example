# Zugangsdaten für das QIS/POS-Portal der Hochschule Mittweida
QIS_USERNAME=dein_benutzername
QIS_PASSWORD=dein_kennwort

# Startseite (Login -> Notenanzeige)
QIS_URL=https://qispos.hs-mittweida.de/noten?intranet&m

# Name/Teilstring des Moduls bzw. der Prüfung, dessen Note überwacht werden soll
# (Groß-/Kleinschreibung wird ignoriert, Teilstring-Suche in der Modul-/Prüfungsspalte)
TARGET_MODULE=Analysis 1

# Text des Knopfes/Links, der nach dem Login angeklickt werden muss, um zur
# eigentlichen Notenübersicht zu gelangen. Mehrere Kandidaten können mit "|"
# getrennt angegeben werden, der erste gefundene Treffer wird verwendet.
GRADES_BUTTON_TEXT=Notenspiegel|Leistungsspiegel|Prüfungsergebnisse|Notenübersicht

# true/false: Browser sichtbar (zum Debuggen) oder headless ausführen
HEADLESS=true

# Optional: E-Mail-Benachrichtigung per SMTP, sobald die Note eingetragen wurde.
# Wenn diese Variablen nicht gesetzt sind, wird nur auf der Konsole / im Log ausgegeben.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
